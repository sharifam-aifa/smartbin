        "# The Pima Indians Diabetes Dataset is commonly used and available publicly.\n",
        "# Using a common public URL for demonstration. If you have specific files, please upload them.\n",
        "DATA_URL = \"https://raw.githubusercontent.com/plotly/datasets/master/diabetes.csv\"\n",
