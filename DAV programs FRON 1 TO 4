        "import pandas as pd\n",
        "import numpy as np # Required for np.number in more robust fillna, though df.mean() works on numeric by default\n",
        "\n",
        "# Load dataset into a DataFrame\n",
        "# Using an available sample dataset and replacing 'data.csv'\n",
        "df = pd.read_csv('/content/sample_data/california_housing_train.csv')\n",
        "\n",
        "# Display first and last few rows\n",
        "print(\"First 5 rows:\\n\", df.head())\n",
        "print(\"Last 5 rows:\\n\", df.tail())\n",
        "\n",
        "# Check data types and general info\n",
        "df.info()\n",
        "\n",
        "# Summary statistics\n",
        "print(\"Summary statistics:\\n\", df.describe())\n",
        "\n",
        "# Handle missing values - df.mean() applies only to numeric columns\n",
        "# For better handling, one might select numeric types first, but for this dataset, it's generally fine.\n",
        "df.fillna(df.mean(numeric_only=True), inplace=True)\n",
        "\n",
        "# Create a new column\n",
        "# Replacing 'existing_column' with 'median_income'\n",
        "df['new_column'] = df['median_income'] * 2\n",
        "\n",
        "# Create a Series and perform operations\n",
        "# Replacing 'existing_column' with 'median_income'\n",
        "series = df['median_income']\n",
        "print(\"Series addition:\", series + 10)\n",
        "\n",
        "# Filter rows based on conditions\n",
        "# Replacing 'existing_column' with 'median_income' and 'another_column' with 'housing_median_age'\n",
        "# Adjusted filter conditions for more realistic values in the housing dataset\n",
        "filtered_df = df[(df['median_income'] > 5) & (df['housing_median_age'] < 30)]\n",
        "print(\"Filtered DataFrame:\\n\", filtered_df)\n",
        "\n",
        "# Grouping and aggregation\n",
        "# The 'california_housing_train.csv' dataset does not have 'ocean_proximity'.\n",
        "# Creating a categorical column from 'housing_median_age' for demonstration.\n",
        "df['age_category'] = pd.cut(df['housing_median_age'], bins=[0, 10, 20, 30, 40, 50, np.inf],\n",
        "                            labels=['<10', '10-19', '20-29', '30-39', '40-49', '50+'])\n",
        "\n",
        "grouped = df.groupby('age_category')['median_house_value'].mean()\n",
        "print(\"Grouped mean:\\n\", grouped)\n",
        "\n",
        "# Sorting\n",
        "# Replacing 'numeric_column' with 'median_house_value'\n",
        "df_sorted = df.sort_values(by='median_house_value', ascending=False)\n",
        "print(\"Sorted DataFrame:\\n\", df_sorted)\n",
        "\n",
        "# Boolean masking\n",
        "# Replacing 'numeric_column' with 'median_house_value'\n",
        "masked_df = df[df['median_house_value'] > df['median_house_value'].median()]\n",
        "print(\"Masked DataFrame:\\n\", masked_df)\n",
        "\n",
        "# Remove duplicates and drop missing values\n",
        "df.drop_duplicates(inplace=True)\n",
        "# dropna will remove rows with any remaining NaN values after fillna\n",
        "df.dropna(inplace=True)\n",
        "\n",
        "# Create a new DataFrame with selected columns\n",
        "# Replacing 'column1' and 'column2' with 'longitude' and 'latitude'\n",
        "subset_df = df[['longitude', 'latitude']]\n",
        "\n",
        "# Save the new DataFrame to a CSV file\n",
        "subset_df.to_csv('filtered_data.csv', index=False)\n",
        "\n",
        "# Compute summary statistics\n",
        "# Replacing 'numeric_column' with 'median_house_value'\n",
